{
  "name": "@posthog/plugin-transpiler",
  "version": "1.0.0",
  "description": "Transpiles site apps TSX to browser JS via stdin/stdout",
  "main": "transpile.mjs",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "node init && tsc -b && node build.mjs",
    "start:dist": "node init && node dist/index.js",
    "start": "node init && npm run build && npm run start:dist"
  },
  "author": "PostHog Inc.",
  "license": "MIT",
  "devDependencies": {
    "@babel/standalone": "^7.23.2",
    "@types/babel__standalone": "^7.1.6",
    "@types/node": "^18.11.9",
    "esbuild": "^0.19.5",
    "typescript": "^5.2.2"
  }
}
